@echo off
chcp 65001 > nul
title معرض دكان عبد العزيز للأجهزة الكهربائية - الإصدار v3.2.0
color 0b

echo ================================================================
echo       معرض دكان عبد العزيز للأجهزة الكهربائية والتقسيط
echo              النسخة المحلية الشاملة (الإصدار v3.2.0)
echo ================================================================
echo.

:: التحقق من وجود Node.js
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [تنبيه هام] برنامج Node.js غير مثبت على هذا الكمبيوتر!
    echo لتشغيل النظام محلياً، يرجى تحميل وتثبيت Node.js من الرابط:
    echo https://nodejs.org
    echo.
    echo بعد التثبيت، أعد تشغيل هذا الملف مباشرة.
    echo.
    pause
    exit /b 1
)

:: التحقق من وجود مكتبات التشغيل
if not exist "node_modules" (
    echo [1/3] جاري تثبيت حزم التشغيل لأول مرة، يرجى الانتظار دقيقة...
    call npm install --omit=dev
    echo [✓] تم تجهيز حزم التشغيل بنجاح.
)

echo [1/2] جاري تشغيل خادم النظام وقاعدة البيانات المحلية...
echo [2/2] سيتم فتح شاشة البرنامج في المتصفح تلقائياً خلال ثانيتين...
echo.

start /b "" cmd /c "timeout /t 2 /nobreak >nul && start http://localhost:5959"

node server/index.js

pause
